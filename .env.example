# Base URL of the MPrnt backend API (no trailing slash)
MPRNT_API_URL=http://localhost:3000/api/v1

# Shared secret with the backend (its ADMIN_PROXY_SECRET). Lets the backend
# attribute each request to the admin's real IP instead of this server's, for
# per-admin rate limiting and a meaningful audit log.
# Generate with: openssl rand -base64 48
MPRNT_PROXY_SECRET=
